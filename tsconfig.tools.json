{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "tools/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/browser/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
